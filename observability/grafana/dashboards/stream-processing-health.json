{
  "title": "Stream Processing Health",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{service}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stream Events Published",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(stream_events_published_total[5m])) by (service, topic)",
          "legendFormat": "{{service}} / {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Broker Publish Latency p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(broker_publish_latency_seconds_bucket[5m])) by (le, service, topic, status))",
          "legendFormat": "{{service}} / {{topic}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Broker Publish Failures",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "increase(broker_publish_failures_total[15m])",
          "legendFormat": "{{service}} / {{topic}} / {{error}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feature Cache Operations",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "increase(feature_cache_operations_total[30m])",
          "legendFormat": "{{operation}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Stream and Broker Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "{compose_service=~\"ingestion-service|feature-service|decision-service|feedback-service|redpanda\"} | json | message=~\".*(broker|kafka|dead_letter|publish|consumer).*\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
