{
  "title": "Drift and Model Behavior",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Model Score p50/p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(model_score_distribution_bucket[15m])) by (le, model_name))",
          "legendFormat": "p50 {{model_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(model_score_distribution_bucket[15m])) by (le, model_name))",
          "legendFormat": "p95 {{model_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Shadow Divergence Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(shadow_model_divergence_total[30m])) by (active_model, candidate_model)",
          "legendFormat": "{{active_model}} vs {{candidate_model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drift Alerts by Feature",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "increase(drift_alerts_total[1h])",
          "legendFormat": "{{feature_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model-Service HTTP Errors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"model-service\",status=~\"5..\"}[5m])) by (path)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Model and Drift Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "{compose_service=\"model-service\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
