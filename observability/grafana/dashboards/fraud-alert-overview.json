{
  "title": "Fraud Alert Overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Rule Hits by Rule",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "increase(rule_hits_total[30m])",
          "legendFormat": "{{rule_name}} / {{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Decision Outcomes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(decision_outcomes_total[30m])) by (outcome, degraded_mode)",
          "legendFormat": "{{outcome}} / degraded={{degraded_mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model Score p95 by Model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(model_score_distribution_bucket[15m])) by (le, model_name))",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feedback Labels",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "increase(feedback_labels_total[1h])",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Shadow Divergence",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "increase(shadow_model_divergence_total[1h])",
          "legendFormat": "{{active_model}} vs {{candidate_model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Fraud-Relevant Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "{compose_service=~\"decision-service|feedback-service|model-service\"} | json | message=~\".*(decision|feedback|shadow|fraud).*\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
