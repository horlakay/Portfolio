ENVIRONMENT=local
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-real-environments
JWT_ISSUER=sentinelstream
JWT_AUDIENCE=sentinelstream-analyst
ANALYST_CONSOLE_PASSWORD=demo-password
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelstream
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
RAW_EVENTS_TOPIC=sentinel.events.raw
DECISIONS_TOPIC=sentinel.events.decisions
FEEDBACK_TOPIC=sentinel.events.feedback
DLQ_TOPIC=sentinel.events.dlq
FEATURE_SERVICE_URL=http://feature-service:8002
RULE_ENGINE_URL=http://rule-engine:8003
MODEL_SERVICE_URL=http://model-service:8004
DECISION_SERVICE_URL=http://decision-service:8005
FEEDBACK_SERVICE_URL=http://feedback-service:8006
INGESTION_SERVICE_URL=http://ingestion-service:8001
ANALYST_CONSOLE_URL=http://analyst-console:8007
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
